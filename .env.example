# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL for production)
DB_NAME=keystonebid
DB_USER=keystonebid_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Email (AWS SES for production)
DEFAULT_FROM_EMAIL=noreply@keystonebid.com
SERVER_EMAIL=admin@keystonebid.com
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-ses-smtp-username
EMAIL_HOST_PASSWORD=your-ses-smtp-password

# Stripe Payment
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AWS S3 (Optional - for production media files)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=keystonebid-media
# AWS_S3_REGION_NAME=us-east-1

# Image prefill (see config/settings/base.py)
# local = run the prefill package in-process (dev); lambda = AWS path (10.19)
PREFILL_BACKEND=local
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Address autocomplete (optional — plain inputs without it)
GOOGLE_MAPS_API_KEY=

# Moderation: free message-scan classifier (optional — the scan
# degrades to watch-terms only without it).
OPENAI_API_KEY=
# Dedicated Claude key for moderation escalation (optional — falls back
# to ANTHROPIC_API_KEY; best practice is one key per workload).
ANTHROPIC_MODERATION_API_KEY=
